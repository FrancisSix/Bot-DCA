# Environment Variables Configuration Guide
#
# Copy the appropriate block below into .env inside the respective sub-package,
# or create dedicated .env files inside /contracts, /keeper, and /frontend.

# ==========================================
# 1. /contracts/.env
# ==========================================
# Deployer private key (hex, with or without 0x). Never commit real keys.
PRIVATE_KEY=
MAINNET_RPC=https://rpc.botchain.ai
TESTNET_RPC=https://rpc.bohr.life

# ==========================================
# 2. /keeper/.env
# ==========================================
CHAIN_ID=968
RPC_URL=https://rpc.bohr.life
DCA_ADDRESS=0x71D3E22e60Fa9f6f2d6A3347c7Bb49D25da9FA98
KEEPER_PRIVATE_KEY=
SWEEP_INTERVAL_MS=10000
REFRESH_INTERVAL_MS=10000

# ==========================================
# 3. /frontend/.env
# ==========================================
VITE_DCA_ADDRESS=0x71D3E22e60Fa9f6f2d6A3347c7Bb49D25da9FA98
VITE_RPC_URL=https://rpc.bohr.life

